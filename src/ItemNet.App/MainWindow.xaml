<Window x:Class="ItemNet.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ItemNet.App.ViewModels"
        Title="ItemNet" Width="1500" Height="980" MinWidth="1000" MinHeight="650"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <vm:InverseBoolConverter x:Key="Not"/>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="Caption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Margin" Value="0,10,0,3"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="ViewImage" TargetType="Image">
            <Setter Property="Stretch" Value="Uniform"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality"/>
            <Setter Property="Margin" Value="3"/>
        </Style>
    </Window.Resources>

    <Grid>
        <DockPanel>
            <Border DockPanel.Dock="Top" Background="#F3F3F3" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="8,6">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="Reload" Command="{Binding ReloadCommand}"/>
                        <Button Content="Settings…" Click="OnSettings"/>
                    </StackPanel>
                    <TextBlock Text="{Binding SourceText}" VerticalAlignment="Center" Foreground="#444" TextTrimming="CharacterEllipsis"/>
                </DockPanel>
            </Border>

            <StatusBar DockPanel.Dock="Bottom">
                <StatusBarItem>
                    <TextBlock Text="{Binding StatusText}" TextTrimming="CharacterEllipsis"/>
                </StatusBarItem>
            </StatusBar>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="460" MinWidth="300"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Item list -->
                <DockPanel Grid.Column="0" Margin="8">
                    <TextBox DockPanel.Dock="Top" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="4"
                             ToolTip="Search by name, EditorID or plugin"/>
                    <DockPanel DockPanel.Dock="Top" Margin="0,6">
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ItemCount}" VerticalAlignment="Center" Foreground="#666"/>
                        <TextBlock Text="Show:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox ItemsSource="{Binding StatusFilters}" SelectedItem="{Binding Filter}" Width="160" HorizontalAlignment="Left"
                                  ToolTip="Filter by where the selected gender's description comes from"/>
                    </DockPanel>
                    <ListView ItemsSource="{Binding ItemsView}" SelectedItem="{Binding Selected}"
                              VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Name" DisplayMemberBinding="{Binding Name}" Width="190"/>
                                <GridViewColumn Header="Kind" DisplayMemberBinding="{Binding Kind}" Width="75"/>
                                <GridViewColumn Header="F" DisplayMemberBinding="{Binding FemaleText}" Width="60"/>
                                <GridViewColumn Header="M" DisplayMemberBinding="{Binding MaleText}" Width="60"/>
                                <GridViewColumn Header="Plugin" DisplayMemberBinding="{Binding Plugin}" Width="160"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </DockPanel>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="#E5E5E5"/>

                <!-- Detail -->
                <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12,8,12,12">
                        <TextBlock Text="{Binding Details}" TextWrapping="Wrap" FontSize="13"/>

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                            <RadioButton Content="Female" IsChecked="{Binding IsFemale}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <RadioButton Content="Male" IsChecked="{Binding IsFemale, Converter={StaticResource Not}}" VerticalAlignment="Center" Margin="0,0,20,0"/>
                            <TextBlock Text="Mannequin:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding MannequinChoices}" SelectedItem="{Binding Mannequin}" Width="100" Margin="0,0,20,0"/>
                            <TextBlock Text="Weight:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <Slider Minimum="0" Maximum="1" Value="{Binding Weight}" Width="140" VerticalAlignment="Center"
                                    ToolTip="BodySlide weight (0 thin, 1 heavy)"/>
                            <Button Content="Re-render" Command="{Binding RenderCommand}" Margin="20,0,6,0"/>
                            <TextBlock Text="Rendering…" Foreground="#888" VerticalAlignment="Center"
                                       Visibility="{Binding IsRendering, Converter={StaticResource BoolToVis}}"/>
                        </StackPanel>

                        <UniformGrid Columns="4" MaxWidth="1600" HorizontalAlignment="Left">
                            <Image Source="{Binding Views[0]}" Style="{StaticResource ViewImage}" ToolTip="Front"/>
                            <Image Source="{Binding Views[1]}" Style="{StaticResource ViewImage}" ToolTip="Right"/>
                            <Image Source="{Binding Views[2]}" Style="{StaticResource ViewImage}" ToolTip="Back"/>
                            <Image Source="{Binding Views[3]}" Style="{StaticResource ViewImage}" ToolTip="Left"/>
                        </UniformGrid>
                        <TextBlock Text="{Binding RenderWarnings}" Foreground="#B5651D" TextWrapping="Wrap"/>

                        <Expander Header="SkyrimNet's current entry" Margin="0,8,0,0" IsExpanded="True">
                            <StackPanel Margin="4">
                                <TextBlock Text="{Binding SkyrimNetSource}" Foreground="#666"/>
                                <TextBlock Text="{Binding SkyrimNetName}" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding SkyrimNetDescription}" TextWrapping="Wrap"/>
                                <UniformGrid Columns="4" Height="150" Margin="0,4,0,0">
                                    <Image Source="{Binding SkyrimNetViews[0]}" Style="{StaticResource ViewImage}"/>
                                    <Image Source="{Binding SkyrimNetViews[1]}" Style="{StaticResource ViewImage}"/>
                                    <Image Source="{Binding SkyrimNetViews[2]}" Style="{StaticResource ViewImage}"/>
                                    <Image Source="{Binding SkyrimNetViews[3]}" Style="{StaticResource ViewImage}"/>
                                </UniformGrid>
                            </StackPanel>
                        </Expander>

                        <DockPanel Margin="0,12,0,0">
                            <TextBlock Text="Model:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" Width="420" Margin="0,0,10,0"/>
                            <Button Command="{Binding DescribeCommand}" MinWidth="90">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                                        <Setter Property="Content" Value="Describe"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsDescribing}" Value="True">
                                                <Setter Property="Content" Value="Cancel"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <TextBlock Text="{Binding DescribeInfo}" VerticalAlignment="Center" Foreground="#666" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>

                        <TextBlock Text="Name" Style="{StaticResource Caption}"/>
                        <TextBox Text="{Binding SuggestedName, UpdateSourceTrigger=PropertyChanged}" Padding="4"/>
                        <TextBlock Text="Description" Style="{StaticResource Caption}"/>
                        <TextBox Text="{Binding Description, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True"
                                 MinHeight="110" Padding="4" VerticalScrollBarVisibility="Auto"/>

                        <Expander Header="Model's raw reply" Margin="0,6,0,0">
                            <TextBox Text="{Binding RawReply, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" MaxHeight="220"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas"/>
                        </Expander>

                        <DockPanel Margin="0,12,0,0">
                            <TextBlock Text="SkyrimNet database:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <ComboBox ItemsSource="{Binding Databases}" SelectedItem="{Binding SelectedDatabase}" DisplayMemberPath="Name"
                                      Width="340" Margin="0,0,10,0" ToolTip="Each SkyrimNet playthrough has its own database; the newest is selected by default"/>
                            <Button Content="Save" Command="{Binding SaveCommand}" MinWidth="90" FontWeight="SemiBold" HorizontalAlignment="Left"/>
                        </DockPanel>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </DockPanel>

        <!-- Loading overlay -->
        <Border Background="#C0FFFFFF" Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="Loading…" FontSize="20" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding LoadingText}" Foreground="#555" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                <ProgressBar IsIndeterminate="True" Width="260" Height="6" Margin="0,10,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
