<Window x:Class="ItemNet.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ItemNet settings" Width="1100" Height="720" MinWidth="800" MinHeight="500"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{DynamicResource ApplicationBackgroundBrush}" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Window.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="12,4"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
        </Style>
        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,0,8"/>
        </Style>
    </Window.Resources>
    <DockPanel Margin="10">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
            <Button Content="OK" IsDefault="True" Click="OnOk" MinWidth="80"/>
            <Button Content="Cancel" IsCancel="True" MinWidth="80" Margin="0"/>
        </StackPanel>

        <TabControl>
            <TabItem Header="Data source">
                <StackPanel Margin="12">
                    <RadioButton x:Name="ModeGame" Content="Game folder (use this when ItemNet is launched from Mod Organizer 2)" Margin="0,0,0,4"/>
                    <DockPanel Margin="20,0,0,4">
                        <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowseGame" Margin="6,0,0,0"/>
                        <TextBox x:Name="GamePath" Padding="3"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="20,0,0,12"
                               Text="Reads Data and plugins.txt as this process sees them, so MO2's virtual file system supplies your mods and profile."/>

                    <RadioButton x:Name="ModeMo2" Content="MO2 instance and profile, read directly (no need to launch through MO2)" Margin="0,0,0,4"/>
                    <DockPanel Margin="20,0,0,4">
                        <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowseMo2" Margin="6,0,0,0"/>
                        <TextBox x:Name="Mo2Path" Padding="3" LostFocus="OnMo2PathChanged"/>
                    </DockPanel>
                    <StackPanel Orientation="Horizontal" Margin="20,0,0,4">
                        <TextBlock Text="Profile:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <ComboBox x:Name="Mo2Profile" Width="240" IsEditable="True"/>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Hint}" Margin="20,0,0,12"
                               Text="Point at the instance folder (where mods, profiles and overwrite live) or its ModOrganizer.ini."/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Providers">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Import from SkyrimNet" Click="OnImport" FontWeight="SemiBold"/>
                        <Button Content="Add" Click="OnAddProvider"/>
                        <Button Content="Remove" Click="OnRemoveProvider"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                               Text="OpenAI-compatible chat-completions endpoints. Importing reads SkyrimNet's Providers.yaml and its active preset's vision models. Keys are stored in %LOCALAPPDATA%\ItemNet\settings.json. Extra JSON is merged into every request body (for example OpenRouter's provider routing)."/>
                    <DataGrid x:Name="ProvidersGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Id" Binding="{Binding Id}" Width="120"/>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="140"/>
                            <DataGridTextColumn Header="Endpoint" Binding="{Binding Endpoint}" Width="320"/>
                            <DataGridTemplateColumn Header="API key" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><TextBlock Text="{Binding MaskedKey}" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                                <DataGridTemplateColumn.CellEditingTemplate>
                                    <DataTemplate><TextBox Text="{Binding ApiKey, UpdateSourceTrigger=PropertyChanged}"/></DataTemplate>
                                </DataGridTemplateColumn.CellEditingTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Extra JSON" Binding="{Binding ExtraJson}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Vision models">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Add" Click="OnAddModel"/>
                        <Button Content="Remove" Click="OnRemoveModel"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                               Text="Blank numbers are left out of the request. Reasoning: low / medium / high, or blank for none (sent as {&quot;reasoning&quot;: {&quot;effort&quot;: …}}). Reasoning models need enough max tokens to finish thinking and still answer."/>
                    <DataGrid x:Name="ModelsGrid" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Model" Binding="{Binding Model}" Width="270"/>
                            <DataGridTextColumn Header="Provider id" Binding="{Binding ProviderId}" Width="110"/>
                            <DataGridTextColumn Header="Max tokens" Binding="{Binding MaxTokens}" Width="80"/>
                            <DataGridTextColumn Header="Temp" Binding="{Binding Temperature}" Width="55"/>
                            <DataGridTextColumn Header="Top P" Binding="{Binding TopP}" Width="55"/>
                            <DataGridTextColumn Header="Top K" Binding="{Binding TopK}" Width="55"/>
                            <DataGridTextColumn Header="Reasoning" Binding="{Binding Reasoning}" Width="75"/>
                            <DataGridTextColumn Header="Timeout s" Binding="{Binding Timeout}" Width="70"/>
                            <DataGridTextColumn Header="Extra JSON" Binding="{Binding ExtraJson}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem Header="Prompt">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                        <Button Content="Reset to default" Click="OnResetPrompt"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Hint}"
                               Text="Scriban template. Variables: name, editor_id, kind, body_areas, keywords, value, weight, armor_rating, gender, race, mannequin_textured, views. SkyrimNet's names also work (subject_name, item_type, item_keywords, …); a pasted SkyrimNet prompt only needs its {% if %} blocks rewritten as {{ if }} … {{ end }}. The reply must be JSON with suggestedName and description."/>
                    <TextBox x:Name="PromptBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" FontFamily="Consolas"
                             VerticalScrollBarVisibility="Auto"/>
                </DockPanel>
            </TabItem>

            <TabItem Header="Appearance &amp; storage">
                <StackPanel Margin="12">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Theme:" VerticalAlignment="Center" Width="150"/>
                        <ComboBox x:Name="ThemeBox" Width="100">
                            <ComboBoxItem Content="Dark"/>
                            <ComboBoxItem Content="Light"/>
                            <ComboBoxItem Content="System"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="Image size per view:" VerticalAlignment="Center" Width="150"/>
                        <ComboBox x:Name="RenderSizeBox" Width="100">
                            <ComboBoxItem Content="384"/>
                            <ComboBoxItem Content="512"/>
                            <ComboBoxItem Content="768"/>
                            <ComboBoxItem Content="1024"/>
                        </ComboBox>
                        <TextBlock Text="SkyrimNet uses 512." Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    </StackPanel>
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock Text="Catalog folder:" VerticalAlignment="Center" Width="150"/>
                        <Button DockPanel.Dock="Right" Content="Browse…" Click="OnBrowseCatalog" Margin="6,0,0,0"/>
                        <TextBox x:Name="CatalogFolder" Padding="3"/>
                    </DockPanel>
                    <TextBlock Style="{StaticResource Hint}"
                               Text="ItemNet's own store (ItemNet.db and images), keyed by plugin and FormID rather than load order, so it survives load-order changes and new playthroughs."/>
                    <TextBlock Margin="0,20,0,0">
                        <Hyperlink x:Name="ProjectLink" RequestNavigate="OnProjectLink">ItemNet on GitHub</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
